<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_clair">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nouveau rendez-vous"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/bleu_principal"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Invitez vos contacts à vous retrouver, par SMS."
            android:textColor="@color/gris_texte"
            android:layout_marginBottom="20dp" />

        <!-- ===== QUOI ET QUAND ===== -->
        <TextView
            style="@style/Titre.Section"
            android:text="Quoi et quand" />

        <EditText
            android:id="@+id/editTitre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Titre (ex : Café, Réunion projet…)"
            android:inputType="textCapSentences"
            android:maxLength="60"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/boutonDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📅 Date"
                android:onClick="choisirDate" />

            <Button
                android:id="@+id/boutonHeure"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🕒 Heure"
                android:onClick="choisirHeure" />
        </LinearLayout>

        <!-- ===== QUI ===== -->
        <TextView
            style="@style/Titre.Section"
            android:text="Qui" />

        <EditText
            android:id="@+id/editNumero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex : 0601020304;0611223344"
            android:inputType="phone"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Séparez plusieurs numéros par un point-virgule ;"
            android:textSize="12sp"
            android:textColor="@color/gris_texte"
            android:layout_marginBottom="8dp" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Ajouter un contact"
            android:onClick="choisirContact"
            android:layout_marginBottom="20dp" />

        <!-- ===== OÙ ===== -->
        <TextView
            style="@style/Titre.Section"
            android:text="Où (facultatif)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editLatitude"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Latitude"
                android:inputType="numberDecimal|numberSigned" />

            <EditText
                android:id="@+id/editLongitude"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Longitude"
                android:inputType="numberDecimal|numberSigned" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Laissez vide pour utiliser votre position GPS actuelle."
            android:textSize="12sp"
            android:textColor="@color/gris_texte"
            android:layout_marginBottom="8dp" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗺 Voir le lieu sur la carte"
            android:onClick="afficherPositionSurCarte"
            android:layout_marginBottom="20dp" />

        <!-- ===== ACTIONS ===== -->
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Envoyer l'invitation"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/bleu_principal"
            android:onClick="envoyerInvitation"
            android:layout_marginBottom="8dp" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 Mes rendez-vous"
            android:onClick="ouvrirHistorique"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/textStatut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="En attente du GPS..."
            android:textSize="13sp"
            android:textColor="@color/gris_texte"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>
