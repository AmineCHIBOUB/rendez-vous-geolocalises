<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_clair">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textSens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gris_texte"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textTitre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/bleu_principal"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textDate"
            style="@style/LigneInfo" />

        <TextView
            android:id="@+id/textStatut"
            style="@style/LigneInfo"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/titreParticipants"
            style="@style/TitreSection"
            android:layout_marginTop="12dp"
            android:text="Réponses des invités" />

        <TextView
            android:id="@+id/textParticipants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🗺 Carte"
                android:onClick="afficherCarte" />

            <Button
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🧭 Itinéraire"
                android:onClick="lancerItineraire" />
        </LinearLayout>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📤 Partager (WhatsApp, e-mail…)"
            android:onClick="partager"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/boutonAnnuler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚫 Annuler le rendez-vous"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/rouge_refuser"
            android:onClick="annulerRendezVous"
            android:layout_marginBottom="8dp" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗑 Supprimer de l'historique"
            android:onClick="supprimer" />

    </LinearLayout>
</ScrollView>
